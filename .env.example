# Copy to .env. Empty PBSTREAM_FILE starts without localization; use start-mapping.
ROBOT_TYPE=omni_3wd
# chassis_3d_ur5e: assembled robot; chassis_3d: original chassis-only deployment
ROBOT_PROFILE=chassis_3d_ur5e
ROBOT_PACKAGE=simulated_chassis
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ROS_DOMAIN_ID=0
USE_SIM_TIME=true
MANAGE_NAVIGATION=true
PBSTREAM_FILE=
SLAM_ALGORITHM=lightning
# Lightning: /ros2_ws/maps/lm_map (map directory); Cartographer: .pbstream file
# Compilation parallelism; keep low on memory-constrained hosts.
BUILD_JOBS=2
# Example: /ros2_ws/maps/map1008Pro/map1008Pro.pbstream
WEBSOCKET_PORT=9090
AGV_ID=AGV001
GAZEBO_GUI=false
START_RVIZ=false
BACK_UP_MAX_HEADING_ERROR_DEG=20.0

# Docker host HTTP port; container listens on 8089.
MAP_3D_PORT=8089
URDF_MESH_PORT=8090
