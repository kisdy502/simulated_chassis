# Copy to .env. Empty PBSTREAM_FILE starts without localization; use start-mapping.
ROBOT_TYPE=omni_3wd
ROBOT_PACKAGE=simulated_chassis
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ROS_DOMAIN_ID=0
USE_SIM_TIME=true
MANAGE_NAVIGATION=true
PBSTREAM_FILE=
# Example: /ros2_ws/maps/map1008Pro/map1008Pro.pbstream
WEBSOCKET_PORT=9090
AGV_ID=AGV001
GAZEBO_GUI=false
START_RVIZ=false
BACK_UP_MAX_HEADING_ERROR_DEG=20.0
