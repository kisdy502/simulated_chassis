# Copy to .env. Empty PBSTREAM_FILE starts without localization; use start-mapping.
ROBOT_TYPE=omni_3wd
# chassis_3d_ur5e: assembled robot; chassis_3d: original chassis-only deployment
ROBOT_PROFILE=chassis_3d_ur5e
TOOL_TYPE=gripper
ROBOT_PACKAGE=simulated_chassis
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# 双机器人并行：docker 这套用 domain 1，WSL 原生机器人(AGV001)用 domain 0，杜绝 DDS 串台
ROS_DOMAIN_ID=1
USE_SIM_TIME=true
MANAGE_NAVIGATION=true
# 初始定位地图（与 WSL 原生机器人一致用 map1025L，lightning 格式）
PBSTREAM_FILE=/ros2_ws/maps/map1025L
# Example: /ros2_ws/maps/map1008Pro/map1008Pro.pbstream
# WSL 与 Docker 仿真交替运行，宿主机保留标准端口 9090/8089/8090。
# WEBSOCKET_PORT 仅控制宿主机映射；同网络 Docker 上位机使用 ws://agv-bridge:9090。
WEBSOCKET_PORT=9090
MAP_3D_PORT=8089
URDF_MESH_PORT=8090
AGV_ID=AGV002
GAZEBO_GUI=false
START_RVIZ=false
BACK_UP_MAX_HEADING_ERROR_DEG=20.0
SLAM_ALGORITHM=lightning
