# ==================== 通用配置 ====================
COMPOSE_PROJECT_NAME=agv-robot

# ==================== 机器人配置 ====================
ROBOT_TYPE=diff_drive
AGV_ID=AGV001

# ==================== 上位机连接配置（由上位机compose管理）====================
SPRINGBOOT_HOST=host.docker.internal
SPRINGBOOT_PORT=22777
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
MQTT_HOST=host.docker.internal
MQTT_PORT=1883

# ==================== Bridge配置 ====================
WEBSOCKET_PORT=9090

# ==================== 仿真配置 ====================
GAZEBO_GUI=false
DISPLAY=:0

# ==================== ROS2配置 ====================
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
