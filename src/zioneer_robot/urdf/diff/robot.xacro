<?xml version="1.0"?>
<robot name="$(arg robot_name)"
    xmlns:xacro="http://ros.org/wiki/xacro">

    <!--
    差速底盘 XACRO 总入口 (适配 ROS2 Humble/Jazzy + Gazebo Fortress/Garden)
    传感器：前3D雷达 + 后3D雷达（双Mid-360仿真）+ IMU
    -->

    <xacro:arg name="robot_name" default="zioneerDiffRobot"/>
    <!-- 转为 property 供子文件使用 -->
    <xacro:property name="robot_name" value="$(arg robot_name)"/>

    <!-- 载入核心结构（常量、底盘、轮子） -->
    <xacro:include filename="common_properties.xacro" />
    <xacro:include filename="diff_base.xacro" />
    <xacro:include filename="diff_wheels.xacro" />

    <!-- 仿真：Gazebo 传感器 + ros2_control -->
    <xacro:include filename="sensors_gazebo.xacro" />
    <xacro:include filename="ros2_control_sim.xacro" />

</robot>
