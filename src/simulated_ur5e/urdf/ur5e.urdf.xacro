<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur">
  <!-- Overrides only the initial posture; all geometry comes from UR. -->
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="initial_positions_file" default="$(find simulated_ur5e)/config/initial_positions.yaml"/>
  <xacro:include filename="$(find ur_description)/urdf/ur.urdf.xacro"/>
</robot>
