<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="three_wheel_agv">

  <!-- ==================== Base Footprint ==================== -->
  <link name="base_footprint">
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.15" rpy="0 0 0" />
  </joint>

  <!-- ==================== Base Link ==================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="60.0" />
      <!-- 惯量按箱体 0.8 x 0.6 x 0.18 公式计算（Ixx=m/12*(y²+z²) 等） -->
      <inertia ixx="1.96" ixy="0.0" ixz="0.0" iyy="3.36" iyz="0.0" izz="5.0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.8 0.6 0.18" />
      </geometry>
      <material name="green">
        <color rgba="0.1 0.8 0.1 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.8 0.6 0.18" />
      </geometry>
    </collision>
    <!-- 雷达安装垫柱（高1cm：底盘顶面 z=0.09 → 雷达座 z=0.10），位置随雷达外移至前后边缘 -->
    <visual>
      <origin xyz="0.36 0 0.095" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.025" length="0.01" />
      </geometry>
      <material name="grey" />
    </visual>
    <visual>
      <origin xyz="-0.36 0 0.095" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.025" length="0.01" />
      </geometry>
      <material name="grey" />
    </visual>
  </link>

  <!-- ==================== IMU ==================== -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.04 0.02" />
      </geometry>
      <material name="purple">
        <color rgba="0.8 0.0 0.8 1.0" />
      </material>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- ==================== 3D Lidar 双雷达（前+后，Mid-360 仿真） ==================== -->
  <!-- 雷达经1cm垫柱安装在底盘顶面（雷达座 z=0.10，世界高度0.25），并外移至前后边缘：
       底座半径0.04，中心取±0.36 使外沿与底盘边缘(±0.4)对齐，
       前后向俯角射线出射即越过底盘边缘；侧向>约2°的俯角射线会打在自家底盘上，
       机身两侧近处存在小范围盲区 -->
  <!-- 前雷达：底盘前边缘，前倾5°(rpy.pitch=+0.0873，顶部向前) -->
  <link name="front_lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
    <!-- 半球穹顶雷达外形：底座圆柱 + 球体(下半埋入底座，只露上半球)，仿 Mid-360 -->
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.04" />
      </geometry>
      <material name="lidar_base">
        <color rgba="0.12 0.12 0.12 1.0" />
      </material>
    </visual>
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.04" />
      </geometry>
      <material name="lidar_dome">
        <color rgba="0.22 0.22 0.22 1.0" />
      </material>
    </visual>
  </link>

  <joint name="front_lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="front_lidar_link" />
    <origin xyz="0.36 0 0.10" rpy="0 0.0873 0" />
  </joint>

  <!-- 后雷达：底盘后边缘，朝后(yaw=π)+后倾5° → 覆盖机器人正后方 -->
  <link name="rear_lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
    <!-- 半球穹顶雷达外形：底座圆柱 + 球体(下半埋入底座，只露上半球)，仿 Mid-360 -->
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.04" />
      </geometry>
      <material name="lidar_base">
        <color rgba="0.12 0.12 0.12 1.0" />
      </material>
    </visual>
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.04" />
      </geometry>
      <material name="lidar_dome">
        <color rgba="0.22 0.22 0.22 1.0" />
      </material>
    </visual>
  </link>

  <joint name="rear_lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="rear_lidar_link" />
    <origin xyz="-0.36 0 0.10" rpy="0 0.0873 3.1416" />
  </joint>

  <!-- ==================== Front Steering Module ==================== -->
  <link name="wheel_front_steering_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1.5" />
      <inertia ixx="0.0045" ixy="0.0" ixz="0.0" iyy="0.0045" iyz="0.0" izz="0.0075" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.03" length="0.06" />
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0" />
      </material>
    </visual>
  </link>

  <joint name="wheel_front_steering_joint" type="revolute">
    <parent link="base_link" />
    <child link="wheel_front_steering_link" />
    <origin xyz="0.3 0.0 -0.05" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="5.0" />
  </joint>

  <link name="wheel_front_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="3.0" />
      <inertia ixx="0.0091" ixy="0.0" ixz="0.0" iyy="0.0091" iyz="0.0" izz="0.015" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.08" />
      </geometry>
      <material name="orange_wheel">
        <color rgba="1.0 0.35 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.08" />
      </geometry>
    </collision>
  </link>

  <joint name="wheel_front_wheel_joint" type="revolute">
    <parent link="wheel_front_steering_link" />
    <child link="wheel_front_wheel_link" />
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1e9" upper="1e9" effort="10.0" velocity="10.0" />
  </joint>

  <!-- ==================== Left Steering Module ==================== -->
  <link name="wheel_left_steering_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1.5" />
      <inertia ixx="0.0045" ixy="0.0" ixz="0.0" iyy="0.0045" iyz="0.0" izz="0.0075" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.03" length="0.06" />
      </geometry>
      <material name="grey" />
    </visual>
  </link>

  <joint name="wheel_left_steering_joint" type="revolute">
    <parent link="base_link" />
    <child link="wheel_left_steering_link" />
    <origin xyz="-0.15 0.20 -0.05" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="5.0" />
  </joint>

  <link name="wheel_left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="3.0" />
      <inertia ixx="0.0091" ixy="0.0" ixz="0.0" iyy="0.0091" iyz="0.0" izz="0.015" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.08" />
      </geometry>
      <material name="orange_wheel">
        <color rgba="1.0 0.35 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.08" />
      </geometry>
    </collision>
  </link>

  <joint name="wheel_left_wheel_joint" type="revolute">
    <parent link="wheel_left_steering_link" />
    <child link="wheel_left_wheel_link" />
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1e9" upper="1e9" effort="10.0" velocity="10.0" />
  </joint>

  <!-- ==================== Right Steering Module ==================== -->
  <link name="wheel_right_steering_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1.5" />
      <inertia ixx="0.0045" ixy="0.0" ixz="0.0" iyy="0.0045" iyz="0.0" izz="0.0075" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.03" length="0.06" />
      </geometry>
      <material name="grey" />
    </visual>
  </link>

  <joint name="wheel_right_steering_joint" type="revolute">
    <parent link="base_link" />
    <child link="wheel_right_steering_link" />
    <origin xyz="-0.15 -0.20 -0.05" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="5.0" />
  </joint>

  <link name="wheel_right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="3.0" />
      <inertia ixx="0.0091" ixy="0.0" ixz="0.0" iyy="0.0091" iyz="0.0" izz="0.015" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.08" />
      </geometry>
      <material name="orange_wheel">
        <color rgba="1.0 0.35 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.08" />
      </geometry>
    </collision>
  </link>

  <joint name="wheel_right_wheel_joint" type="revolute">
    <parent link="wheel_right_steering_link" />
    <child link="wheel_right_wheel_link" />
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1e9" upper="1e9" effort="10.0" velocity="10.0" />
  </joint>

  <!-- ==================== ros2_control ==================== -->
  <ros2_control name="IgnitionSystem" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <joint name="wheel_front_steering_joint">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="wheel_left_steering_joint">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="wheel_right_steering_joint">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="wheel_front_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="wheel_left_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="wheel_right_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>

  <!-- ==================== Gazebo Plugins ==================== -->
  <gazebo>
    <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>$(find simulated_chassis)/param/three_wheel_controllers.yaml</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
    </plugin>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
    </plugin>
    <plugin name="ignition::gazebo::systems::Imu" filename="ignition-gazebo-imu-system"></plugin>
  </gazebo>

  <!-- ==================== IMU Sensor ==================== -->
  <!-- 工业级中高端 MEMS IMU 噪声模型（Xsens MTi-300/600 量级，100Hz）
       Fortress(ign-sensors6) 各字段实测行为（最小仿真验证）：
       - stddev：逐采样白噪声
       - bias_mean/bias_stddev：上电常值零偏，启动时按 N(bias_mean,bias_stddev) 抽一次，
         整个会话恒定（bias_mean 输出符号实测取反，对称配置不受影响）
       - dynamic_bias_stddev + dynamic_bias_correlation_time：零偏随机游走
         （Gauss-Markov 过程），生效——真机 SLAM 漂移的主因
       - precision 仅 gaussian_quantized 类型有效，32 位输出量化可忽略，不配
       旧配置问题：角速度完全没有零偏项（仿真心测不到陀螺零偏），且白噪声量级
       偏大（0.005rad/s≈0.29°/s/采样，MTi-300 约 0.035°/s；加速度 5mg 也偏大 25 倍） -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>/imu</topic>
      <ignition_frame_id>imu_link</ignition_frame_id>

      <imu>
        <frame_id>imu_link</frame_id>

        <!-- 角速度：白噪声密度约 0.01°/s/√Hz，
           100Hz 下每采样 σ≈0.001 rad/s (0.057°/s)；
           上电零偏 σ≈0.002°/s (3.5e-5 rad/s)；
           零偏随机游走 10°/hr，相关时间 1000s -->
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.00005</bias_stddev>
              <dynamic_bias_stddev>0.00005</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.00005</bias_stddev>
              <dynamic_bias_stddev>0.00005</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.00005</bias_stddev>
              <dynamic_bias_stddev>0.00005</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
            </noise>
          </z>
        </angular_velocity>

        <!-- 线加速度：白噪声密度约 60µg/√Hz，
           100Hz 下每采样 σ≈0.0006 m/s²；
           上电零偏 σ≈0.00015 m/s² (15µg)；
           零偏随机游走 0.05mg，相关时间 1000s -->
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0006</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.00015</bias_stddev>
              <dynamic_bias_stddev>0.0002</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0006</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.00015</bias_stddev>
              <dynamic_bias_stddev>0.0002</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0006</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.00015</bias_stddev>
              <dynamic_bias_stddev>0.0002</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ==================== 双 3D Lidar Sensor (Mid-360 仿真) ==================== -->
  <!-- 垂直视场（传感器系），叠加安装5°下倾后的实际波束（传感器离地0.25m）：
       前雷达 -10°~+45°(32线) → 世界 -15°~+40°，z特征主力；最低ring打地于0.93m，
       前方0.93~2.9m的地面弧线仍会随子图烤进 /map（hit_probability=0.65只压远处
       单次命中，压不住近距反复命中），建图后需检查 /map 前方是否显线。
       后雷达 0°~+10°(32线) → 世界 -5°~+5°，辅助；最低ring打地在2.86m外。
       ros_gz_bridge 的 LaserScan 取垂直中间行：后雷达中间行≈世界+0.16°近水平
       （/scan_2 干净）；前雷达中间行≈世界+13.4°朝上——2D导航(nav2_params_2d.yaml)
       下 /scan_1 只能看到约0.25+0.24·d米高度以上的障碍（0.5m高障碍≈1m内可见），
       低矮障碍感知主要靠点云链路，是已知取舍。 range.min=0.5 近裁剪面：雷达装在±0.36边缘、270°FOV的正后方90°盲区恰好
       罩住机体远半侧（后角0.82m/对向穹顶0.68m/甲板后缘0.76m全部在盲区不可见），
       视场内自身结构最近只有甲板侧沿（≤0.43m），0.5 起 clip 即可保无自打点。
       （旧记录"0.68~0.76m自打点带"与当前±0.36挂载+270°FOV几何矛盾，疑为旧
        挂载时期遗留；改0.5后首次跑仿真应静置验证0.5~0.8m环带无 glued 点） -->

  <!-- 前雷达 -->
  <gazebo reference="front_lidar_link">
    <sensor name="front_lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <topic>/front_lidar/point_cloud</topic>
      <ignition_frame_id>front_lidar_link</ignition_frame_id>

      <lidar>
        <frame_id>front_lidar_link</frame_id>
        <scan>
          <horizontal>
            <samples>270</samples>
            <resolution>1</resolution>
            <min_angle>-2.3562</min_angle>
            <max_angle>2.3562</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <min_angle>-0.1745</min_angle>
            <max_angle>0.7854</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.8</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <bias_mean>0.0</bias_mean>
          <bias_stddev>0.005</bias_stddev>
          <precision>0.01</precision>
          <stddev>0.010</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- 后雷达 -->
  <gazebo reference="rear_lidar_link">
    <sensor name="rear_lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <topic>/rear_lidar/point_cloud</topic>
      <ignition_frame_id>rear_lidar_link</ignition_frame_id>

      <lidar>
        <frame_id>rear_lidar_link</frame_id>
        <scan>
          <horizontal>
            <samples>270</samples>
            <resolution>1</resolution>
            <min_angle>-2.3562</min_angle>
            <max_angle>2.3562</max_angle>
          </horizontal>
          <!-- 0°~+10°（传感器系）→ 世界 -5°~+5°，辅助定位补特征，两个约束：
           ① ros_gz_bridge 的 LaserScan 取垂直中间行(32线第16行≈+5.16°传感器系
              ≈世界+0.16°近水平) → /scan_2 无地面回波；
           ② 最低ring世界-5°打地在2.86m外，避开0.93~2.9m近距反复命中区——
              该区地面弧线会随定位子图烤进 /map，经 static_layer 长期被当成障碍。
              （曾试过与前雷达相同的[-10°,+45°]：中间行朝下1.67°打地8.6m一整圈，
               近距弧线密集烤图，是"后雷达方向一条横线障碍"的直接来源） -->
          <vertical>
            <samples>32</samples>
            <min_angle>-0.1745</min_angle>
            <max_angle>0.7854</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.8</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <bias_mean>0.0</bias_mean>
          <bias_stddev>0.005</bias_stddev>
          <precision>0.01</precision>
          <stddev>0.010</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>



  <!-- 在 robot 标签的末尾，为每个车轮的 link 指定摩擦参数 -->
  <gazebo reference="wheel_front_wheel_link">
    <surface>
      <friction>
        <ode>
          <mu>0.8</mu>
          <mu2>0.6</mu2>
        </ode>
      </friction>
    </surface>
  </gazebo>

  <gazebo reference="wheel_left_wheel_link">
    <surface>
      <friction>
        <ode>
          <mu>0.8</mu>
          <mu2>0.6</mu2>
        </ode>
      </friction>
    </surface>
  </gazebo>

  <gazebo reference="wheel_right_wheel_link">
    <surface>
      <friction>
        <ode>
          <mu>0.8</mu>
          <mu2>0.6</mu2>
        </ode>
      </friction>
    </surface>
  </gazebo>

</robot>