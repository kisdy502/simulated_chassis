<?xml version="1.0"?>
<sdf version='1.9'>
  <world name='test_world'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='ignition::gazebo::systems::Physics' filename='ignition-gazebo-physics-system' />
    <plugin name='ignition::gazebo::systems::UserCommands' filename='ignition-gazebo-user-commands-system' />
    <plugin name='ignition::gazebo::systems::SceneBroadcaster' filename='ignition-gazebo-scene-broadcaster-system' />

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic' />
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <!-- 内净空52.6x47.8，右墙外拐8°顶点外凸至29.66m，地板加宽覆盖五边形凸角 -->
            <size>64 48</size>
          </plane>
        </geometry>
          <surface>
            <friction>
              <ode />
            </friction>
            <bounce />
            <contact />
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>64 48</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <pose>1 -0.5 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1</iyy><iyz>0</iyz><izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <light name='sun' type='directional'>
      <pose>0 0 10 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range><linear>0.01</linear><constant>0.9</constant><quadratic>0.001</quadratic>
      </attenuation>
      <spot><inner_angle>0</inner_angle><outer_angle>0</outer_angle><falloff>0</falloff></spot>
    </light>

    <!-- ==================== 围墙 (内净空52.6x47.8m, 厚0.15m, 高3m) ====================
         原尺寸内净空36.6x31.8，长宽各加大16m(每边外扩8m)。
         外墙形状不变：右墙仍拆两截、各外拐8°，顶点(29.66,-0.5)，
         从点云形态可直接辨别+x朝向。 -->
    <model name='wall'>
      <link name='length_bottom'>
        <pose>0 -24.3 1.5 0 0 0</pose>
        <collision name='c'><geometry><box><size>52.6 0.15 3</size></box></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface></collision>
        <visual name='v'><geometry><box><size>52.6 0.15 3</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
        <enable_wind>false</enable_wind>
      </link>
      <link name='length_top'>
        <pose>0 23.3 1.5 0 0 0</pose>
        <collision name='c'><geometry><box><size>52.6 0.15 3</size></box></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface></collision>
        <visual name='v'><geometry><box><size>52.6 0.15 3</size></box></geometry>
          <material><ambient>0.4 0.5 0.45 1</ambient><diffuse>0.4 0.5 0.45 1</diffuse></material></visual>
        <enable_wind>false</enable_wind>
      </link>
      <link name='width_left'>
        <pose>-26.3 -0.5 1.5 0 0 0</pose>
        <collision name='c'><geometry><box><size>0.15 47.8 3</size></box></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface></collision>
        <visual name='v'><geometry><box><size>0.15 47.8 3</size></box></geometry>
          <material><ambient>0.5 0.4 0.5 1</ambient><diffuse>0.5 0.4 0.5 1</diffuse></material></visual>
        <enable_wind>false</enable_wind>
      </link>
      <!-- 右墙两截各外拐8°，角点(26.3,±)不变，顶点(29.66,-0.5)，各长24.14(23.9/cos8°) -->
      <link name='width_right_north'>
        <pose>27.98 11.45 1.5 0 0 0.1396</pose>
        <collision name='c'><geometry><box><size>0.15 24.14 3</size></box></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface></collision>
        <visual name='v'><geometry><box><size>0.15 24.14 3</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
        <enable_wind>false</enable_wind>
      </link>
      <link name='width_right_south'>
        <pose>27.98 -12.45 1.5 0 0 -0.1396</pose>
        <collision name='c'><geometry><box><size>0.15 24.14 3</size></box></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface></collision>
        <visual name='v'><geometry><box><size>0.15 24.14 3</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
        <enable_wind>false</enable_wind>
      </link>

      <!-- ==================== 内部隔墙 (厚0.72m, 高3m, 全部轴向对齐) ====================
           inner_h1a/h1b: 中央走廊南墙拆两段(原28m只留一半,各7m)，中间14m大开口
           其余隔墙两头各缩短1m，保证车辆畅行：
           inner_h2: 走廊北墙 x∈[-13,13]
           inner_v1: 左上隔断 y∈[6.7,19.1]
           inner_v2: 右下隔断 y∈[-19.1,-6.7]
           inner_h3: 西南房间横墙 x∈[-21.5,-14.5]
           inner_h4: 右上横墙 x∈[15,21] -->
      <link name='inner_h1a'>
        <pose>-10.5 -3.4 1.5 0 0 0</pose>
        <collision name='c'><geometry><box><size>7 0.72 3</size></box></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface></collision>
        <visual name='v'><geometry><box><size>7 0.72 3</size></box></geometry>
          <material><ambient>0.55 0.55 0.45 1</ambient><diffuse>0.55 0.55 0.45 1</diffuse></material></visual>
        <enable_wind>false</enable_wind>
      </link>
      <link name='inner_h1b'>
        <pose>10.5 -3.4 1.5 0 0 0</pose>
        <collision name='c'><geometry><box><size>7 0.72 3</size></box></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface></collision>
        <visual name='v'><geometry><box><size>7 0.72 3</size></box></geometry>
          <material><ambient>0.55 0.55 0.45 1</ambient><diffuse>0.55 0.55 0.45 1</diffuse></material></visual>
        <enable_wind>false</enable_wind>
      </link>
      <link name='inner_h2'>
        <pose>0 2.4 1.5 0 0 0</pose>
        <collision name='c'><geometry><box><size>26 0.72 3</size></box></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface></collision>
        <visual name='v'><geometry><box><size>26 0.72 3</size></box></geometry>
          <material><ambient>0.45 0.5 0.55 1</ambient><diffuse>0.45 0.5 0.55 1</diffuse></material></visual>
        <enable_wind>false</enable_wind>
      </link>
      <link name='inner_v1'>
        <pose>-13 12.9 1.5 0 0 0</pose>
        <collision name='c'><geometry><box><size>0.72 12.4 3</size></box></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface></collision>
        <visual name='v'><geometry><box><size>0.72 12.4 3</size></box></geometry>
          <material><ambient>0.5 0.55 0.45 1</ambient><diffuse>0.5 0.55 0.45 1</diffuse></material></visual>
        <enable_wind>false</enable_wind>
      </link>
      <link name='inner_v2'>
        <pose>13 -12.9 1.5 0 0 0</pose>
        <collision name='c'><geometry><box><size>0.72 12.4 3</size></box></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface></collision>
        <visual name='v'><geometry><box><size>0.72 12.4 3</size></box></geometry>
          <material><ambient>0.55 0.4 0.5 1</ambient><diffuse>0.55 0.4 0.5 1</diffuse></material></visual>
        <enable_wind>false</enable_wind>
      </link>
      <link name='inner_h3'>
        <pose>-18 -14 1.5 0 0 0</pose>
        <collision name='c'><geometry><box><size>7 0.72 3</size></box></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface></collision>
        <visual name='v'><geometry><box><size>7 0.72 3</size></box></geometry>
          <material><ambient>0.5 0.45 0.4 1</ambient><diffuse>0.5 0.45 0.4 1</diffuse></material></visual>
        <enable_wind>false</enable_wind>
      </link>
      <link name='inner_h4'>
        <pose>18 12 1.5 0 0 0</pose>
        <collision name='c'><geometry><box><size>6 0.72 3</size></box></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface></collision>
        <visual name='v'><geometry><box><size>6 0.72 3</size></box></geometry>
          <material><ambient>0.4 0.5 0.5 1</ambient><diffuse>0.4 0.5 0.5 1</diffuse></material></visual>
        <enable_wind>false</enable_wind>
      </link>

      <static>true</static>
      <self_collide>false</self_collide>
    </model>

    <!-- ==================== 特征物体 (Z = 高度/2) ==================== -->
    <!-- 右上角落: 两两组合贴墙(cyl_1+2a紧靠北墙内侧, 2b+3a紧靠东墙内侧) -->
    <model name='fm_cyl_1'><static>true</static><pose>19.55 22.5 1.3 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><cylinder><radius>0.7</radius><length>2.6</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.7</radius><length>2.6</length></cylinder></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual></link></model>
    <model name='fm_box_2a'><static>true</static><pose>18 22.4 0.8 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><box><size>1.7 1.6 1.6</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.7 1.6 1.6</size></box></geometry><material><ambient>0.3 0.5 0.6 1</ambient><diffuse>0.3 0.5 0.6 1</diffuse></material></visual></link></model>
    <model name='fm_box_2b'><static>true</static><pose>26.4 14 1.2 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><box><size>2.0 1.9 2.4</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>2.0 1.9 2.4</size></box></geometry><material><ambient>0.3 0.5 0.6 1</ambient><diffuse>0.3 0.5 0.6 1</diffuse></material></visual></link></model>
    <model name='fm_cyl_3a'><static>true</static><pose>26.6 12.4 0.6 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><cylinder><radius>0.65</radius><length>1.2</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.65</radius><length>1.2</length></cylinder></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual></link></model>

    <!-- 左上西房间(inner_v1以西, 顶部门洞) -->
    <model name='fm_cyl_4'><static>true</static><pose>-19.2 16 1.5 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><cylinder><radius>0.8</radius><length>3.0</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.8</radius><length>3.0</length></cylinder></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual></link></model>
    <model name='fm_box_5a'><static>true</static><pose>-17.5 16 0.8 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><box><size>1.8 1.6 1.6</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.8 1.6 1.6</size></box></geometry><material><ambient>0.3 0.5 0.6 1</ambient><diffuse>0.3 0.5 0.6 1</diffuse></material></visual></link></model>
    <model name='fm_box_5b'><static>true</static><pose>-17.5 18.5 0.6 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><box><size>1.65 1.85 1.2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.65 1.85 1.2</size></box></geometry><material><ambient>0.3 0.5 0.6 1</ambient><diffuse>0.3 0.5 0.6 1</diffuse></material></visual></link></model>

    <!-- 北部大厅(走廊以北开阔区): cyl_big居中, 7b/13a/new5贴其北/南/西, 四件凑成十字 -->
    <model name='fm_cyl_big'><static>true</static><pose>-3 12 1.5 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><cylinder><radius>0.8</radius><length>3.0</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.8</radius><length>3.0</length></cylinder></geometry><material><ambient>0.7 0.6 0.15 1</ambient><diffuse>0.7 0.6 0.15 1</diffuse></material></visual></link></model>
    <model name='fm_box_6'><static>true</static><pose>7 8 0.7 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><box><size>1.7 1.55 1.4</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.7 1.55 1.4</size></box></geometry><material><ambient>0.3 0.5 0.6 1</ambient><diffuse>0.3 0.5 0.6 1</diffuse></material></visual></link></model>
    <model name='fm_cyl_7a'><static>true</static><pose>4.5 8 1.0 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><cylinder><radius>0.675</radius><length>2.0</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.675</radius><length>2.0</length></cylinder></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual></link></model>
    <model name='fm_cyl_7b'><static>true</static><pose>-3 13.63 0.9 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><cylinder><radius>0.825</radius><length>1.8</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.825</radius><length>1.8</length></cylinder></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual></link></model>
    <model name='fm_cub_13a'><static>true</static><pose>-3 10.6 0.95 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><box><size>1.8 1.2 1.9</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.8 1.2 1.9</size></box></geometry><material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material></visual></link></model>
    <model name='fm_box_new5'><static>true</static><pose>-4.65 12 0.9 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><box><size>1.7 1.4 1.8</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.7 1.4 1.8</size></box></geometry><material><ambient>0.5 0.3 0.6 1</ambient><diffuse>0.5 0.3 0.6 1</diffuse></material></visual></link></model>

    <!-- 东部开阔作业区(含五边形凸角): cub_8/9a/9b/box_10 靠拢成一列 -->
    <model name='fm_cub_8'><static>true</static><pose>23 -3 0.9 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><box><size>2.0 1.3 1.8</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>2.0 1.3 1.8</size></box></geometry><material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material></visual></link></model>
    <model name='fm_cyl_9a'><static>true</static><pose>23.5 -5 0.7 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><cylinder><radius>0.75</radius><length>1.4</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.75</radius><length>1.4</length></cylinder></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual></link></model>
    <model name='fm_cyl_9b'><static>true</static><pose>23.5 -6.8 1.0 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><cylinder><radius>0.65</radius><length>2.0</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.65</radius><length>2.0</length></cylinder></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual></link></model>
    <model name='fm_box_10'><static>true</static><pose>23 -9 0.9 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><box><size>1.75 1.9 1.8</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.75 1.9 1.8</size></box></geometry><material><ambient>0.3 0.5 0.6 1</ambient><diffuse>0.3 0.5 0.6 1</diffuse></material></visual></link></model>
    <model name='fm_box_21a'><static>true</static><pose>20 -18 0.8 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><box><size>1.6 1.85 1.6</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.6 1.85 1.6</size></box></geometry><material><ambient>0.2 0.6 0.4 1</ambient><diffuse>0.2 0.6 0.4 1</diffuse></material></visual></link></model>
    <model name='fm_box_21b'><static>true</static><pose>17.7 -18 1.1 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><box><size>1.75 1.7 2.2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.75 1.7 2.2</size></box></geometry><material><ambient>0.2 0.6 0.4 1</ambient><diffuse>0.2 0.6 0.4 1</diffuse></material></visual></link></model>

    <!-- 南部作业区: box_11+12a+12b 尺寸翻倍后紧靠成一组 -->
    <model name='fm_box_11'><static>true</static><pose>0 -8.5 0.8 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><box><size>3.0 3.0 1.6</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>3.0 3.0 1.6</size></box></geometry><material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material></visual></link></model>
    <model name='fm_cyl_12a'><static>true</static><pose>-2.2 -7.9 0.8 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><cylinder><radius>0.7</radius><length>1.6</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.7</radius><length>1.6</length></cylinder></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual></link></model>
    <model name='fm_cyl_12b'><static>true</static><pose>-2.9 -9.9 1.0 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><cylinder><radius>1.4</radius><length>2.0</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>1.4</radius><length>2.0</length></cylinder></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual></link></model>

    <!-- 南部作业区: cub_17+box_19+cyl_18 摆成品字(上一北/下二南) -->
    <model name='fm_cyl_18'><static>true</static><pose>1.9 -13.3 0.9 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><cylinder><radius>0.75</radius><length>1.8</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.75</radius><length>1.8</length></cylinder></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual></link></model>
    <model name='fm_cub_17'><static>true</static><pose>0.5 -15.5 0.7 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><box><size>2.4 1.6 1.4</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>2.4 1.6 1.4</size></box></geometry><material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material></visual></link></model>
    <model name='fm_box_19'><static>true</static><pose>3.2 -15.5 0.7 0 0 0</pose>
      <link name='l'><collision name='c'><geometry><box><size>1.8 1.8 1.4</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.8 1.8 1.4</size></box></geometry><material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material></visual></link></model>

