<?xml version="1.0"?>
<sdf version='1.9'>
  <!-- ============================================================
       world_octagon.sdf  (v2)
       正八边形测试场（36m × 36m bounding box）
       - 外围：8面墙组成正八边形（边长 14.91m，墙高 1.6m，墙厚 0.2m）
       - 内部：6面墙，每面相对 v1 后退 1.5m（让区域更大，方便机器人调头）
       - 特征物：所有边长/直径相对 v1 加大 ~25cm（高度保持 0.5~1.0m 不变）
       ============================================================ -->
  <world name='octagon_world'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system' />
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system' />
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system' />

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic' />
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ==================== 地面 (40×40m) ==================== -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode /></friction>
            <bounce />
            <contact />
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1</iyy><iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <light name='sun' type='directional'>
      <pose>0 0 10 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- ============================================================
         正八边形外墙（不变，墙厚 0.2m，墙高 1.6m，Z 中心 = 0.8）
         ============================================================ -->
    <model name='octagon_wall'>
      <link name='wall_top'>
        <pose>0 18 0.8 0 0 0</pose>
        <collision name='c'>
          <geometry><box><size>14.91 0.2 1.6</size></box></geometry>
          <surface><friction><ode /></friction><bounce /><contact /></surface>
        </collision>
        <visual name='v'>
          <geometry><box><size>14.91 0.2 1.6</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
      <link name='wall_ne'>
        <pose>12.73 12.73 0.8 0 0 -0.7854</pose>
        <collision name='c'>
          <geometry><box><size>14.91 0.2 1.6</size></box></geometry>
          <surface><friction><ode /></friction><bounce /><contact /></surface>
        </collision>
        <visual name='v'>
          <geometry><box><size>14.91 0.2 1.6</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
      <link name='wall_right'>
        <pose>18 0 0.8 0 0 1.5708</pose>
        <collision name='c'>
          <geometry><box><size>14.91 0.2 1.6</size></box></geometry>
          <surface><friction><ode /></friction><bounce /><contact /></surface>
        </collision>
        <visual name='v'>
          <geometry><box><size>14.91 0.2 1.6</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
      <link name='wall_se'>
        <pose>12.73 -12.73 0.8 0 0 0.7854</pose>
        <collision name='c'>
          <geometry><box><size>14.91 0.2 1.6</size></box></geometry>
          <surface><friction><ode /></friction><bounce /><contact /></surface>
        </collision>
        <visual name='v'>
          <geometry><box><size>14.91 0.2 1.6</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
      <link name='wall_bottom'>
        <pose>0 -18 0.8 0 0 0</pose>
        <collision name='c'>
          <geometry><box><size>14.91 0.2 1.6</size></box></geometry>
          <surface><friction><ode /></friction><bounce /><contact /></surface>
        </collision>
        <visual name='v'>
          <geometry><box><size>14.91 0.2 1.6</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
      <link name='wall_sw'>
        <pose>-12.73 -12.73 0.8 0 0 -0.7854</pose>
        <collision name='c'>
          <geometry><box><size>14.91 0.2 1.6</size></box></geometry>
          <surface><friction><ode /></friction><bounce /><contact /></surface>
        </collision>
        <visual name='v'>
          <geometry><box><size>14.91 0.2 1.6</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
      <link name='wall_left'>
        <pose>-18 0 0.8 0 0 1.5708</pose>
        <collision name='c'>
          <geometry><box><size>14.91 0.2 1.6</size></box></geometry>
          <surface><friction><ode /></friction><bounce /><contact /></surface>
        </collision>
        <visual name='v'>
          <geometry><box><size>14.91 0.2 1.6</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
      <link name='wall_nw'>
        <pose>-12.73 12.73 0.8 0 0 0.7854</pose>
        <collision name='c'>
          <geometry><box><size>14.91 0.2 1.6</size></box></geometry>
          <surface><friction><ode /></friction><bounce /><contact /></surface>
        </collision>
        <visual name='v'>
          <geometry><box><size>14.91 0.2 1.6</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
      <static>true</static>
      <self_collide>false</self_collide>
    </model>

    <!-- ============================================================
         内部隔墙（v2：每面后退 1.5m，墙高 1.2m，墙厚 0.2m，Z 中心 = 0.6）
         v1 → v2 位置变化：
           wall_i1: (-2, 5)    → (-2, 6.5)     [北上 1.5m]
           wall_i2: (-5, -0.5) → (-6.5, -0.5)  [西退 1.5m]
           wall_i3: (2.5, -5)  → (2.5, -6.5)   [南下 1.5m]
           wall_i4: (6, -5)    → (7.5, -5)     [东进 1.5m]
           wall_i5: (-3, 0)    → (-3, -1.5)    [南下 1.5m，把中央北半留大]
           wall_i6: (2, 0.5)   → (3.5, 0.5)    [东进 1.5m，把中央西半留大]
         ============================================================ -->
    <model name='inner_walls'>
      <link name='wall_i1'>
        <pose>-2 6.5 0.6 0 0 0</pose>
        <collision name='c'>
          <geometry><box><size>12 0.2 1.2</size></box></geometry>
          <surface><friction><ode /></friction><bounce /><contact /></surface>
        </collision>
        <visual name='v'>
          <geometry><box><size>12 0.2 1.2</size></box></geometry>
          <material><ambient>0.45 0.5 0.5 1</ambient><diffuse>0.45 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
      <link name='wall_i2'>
        <pose>-6.5 -0.5 0.6 0 0 1.5708</pose>
        <collision name='c'>
          <geometry><box><size>11 0.2 1.2</size></box></geometry>
          <surface><friction><ode /></friction><bounce /><contact /></surface>
        </collision>
        <visual name='v'>
          <geometry><box><size>11 0.2 1.2</size></box></geometry>
          <material><ambient>0.45 0.5 0.5 1</ambient><diffuse>0.45 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
      <link name='wall_i3'>
        <pose>2.5 -6.5 0.6 0 0 0</pose>
        <collision name='c'>
          <geometry><box><size>11 0.2 1.2</size></box></geometry>
          <surface><friction><ode /></friction><bounce /><contact /></surface>
        </collision>
        <visual name='v'>
          <geometry><box><size>11 0.2 1.2</size></box></geometry>
          <material><ambient>0.45 0.5 0.5 1</ambient><diffuse>0.45 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
      <link name='wall_i4'>
        <pose>7.5 -5 0.6 0 0 1.5708</pose>
        <collision name='c'>
          <geometry><box><size>6 0.2 1.2</size></box></geometry>
          <surface><friction><ode /></friction><bounce /><contact /></surface>
        </collision>
        <visual name='v'>
          <geometry><box><size>6 0.2 1.2</size></box></geometry>
          <material><ambient>0.45 0.5 0.5 1</ambient><diffuse>0.45 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
      <link name='wall_i5'>
        <pose>-3 -1.5 0.6 0 0 0</pose>
        <collision name='c'>
          <geometry><box><size>4 0.2 1.2</size></box></geometry>
          <surface><friction><ode /></friction><bounce /><contact /></surface>
        </collision>
        <visual name='v'>
          <geometry><box><size>4 0.2 1.2</size></box></geometry>
          <material><ambient>0.45 0.5 0.5 1</ambient><diffuse>0.45 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
      <link name='wall_i6'>
        <pose>3.5 0.5 0.6 0 0 1.5708</pose>
        <collision name='c'>
          <geometry><box><size>5 0.2 1.2</size></box></geometry>
          <surface><friction><ode /></friction><bounce /><contact /></surface>
        </collision>
        <visual name='v'>
          <geometry><box><size>5 0.2 1.2</size></box></geometry>
          <material><ambient>0.45 0.5 0.5 1</ambient><diffuse>0.45 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
      <static>true</static>
      <self_collide>false</self_collide>
    </model>

    <!-- ============================================================
         特征物体（v2：所有 xy 尺寸 +25cm，高度保持不变）
         对组内的物体，间距同步拉大以避免重叠
         ============================================================ -->

    <!-- ===== 北部大房间 (y > 6.5) ===== -->
    <!-- N1 单个长方体 1.0×0.6 → 1.3×0.9 -->
    <model name='n1_box'>
      <static>true</static>
      <pose>-5 10 0.45 0 0 0</pose>
      <link name='l'>
        <collision name='c'><geometry><box><size>1.3 0.9 0.9</size></box></geometry></collision>
        <visual name='v'>
          <geometry><box><size>1.3 0.9 0.9</size></box></geometry>
          <material><ambient>0.3 0.5 0.6 1</ambient><diffuse>0.3 0.5 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- N2 两个圆柱成对 r=0.25→0.37，间距 0.7→0.95 -->
    <model name='n2_cyl_a'>
      <static>true</static>
      <pose>3 12 0.35 0 0 0</pose>
      <link name='l'>
        <collision name='c'><geometry><cylinder><radius>0.37</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name='v'>
          <geometry><cylinder><radius>0.37</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='n2_cyl_b'>
      <static>true</static>
      <pose>3.95 12 0.35 0 0 0</pose>
      <link name='l'>
        <collision name='c'><geometry><cylinder><radius>0.37</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name='v'>
          <geometry><cylinder><radius>0.37</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- N3 单个三棱柱 scale 0.8→1.1 -->
    <model name='n3_tri'>
      <static>true</static>
      <pose>8 10 0.4 0 0 0</pose>
      <link name='l'>
        <collision name='c'>
          <geometry>
            <mesh>
              <uri>model://triangular_prism/meshes/triangular_prism.dae</uri>
              <scale>1.1 1.1 0.8</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='v'>
          <geometry>
            <mesh>
              <uri>model://triangular_prism/meshes/triangular_prism.dae</uri>
              <scale>1.1 1.1 0.8</scale>
            </mesh>
          </geometry>
          <material><ambient>0.4 0.6 0.3 1</ambient><diffuse>0.4 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== 中央区域 ===== -->
    <!-- C1 单个圆柱 r=0.3→0.42，位置稍微东移避免和 wall_i6 太近 -->
    <model name='c1_cyl'>
      <static>true</static>
      <pose>5 2 0.3 0 0 0</pose>
      <link name='l'>
        <collision name='c'><geometry><cylinder><radius>0.42</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name='v'>
          <geometry><cylinder><radius>0.42</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.3 0.7 0.3 1</ambient><diffuse>0.3 0.7 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- C2 单个三棱柱 scale 0.7→1.0 -->
    <model name='c2_tri'>
      <static>true</static>
      <pose>-2 -3 0.4 0 0 1.5708</pose>
      <link name='l'>
        <collision name='c'>
          <geometry>
            <mesh>
              <uri>model://triangular_prism/meshes/triangular_prism.dae</uri>
              <scale>1.0 1.0 0.8</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='v'>
          <geometry>
            <mesh>
              <uri>model://triangular_prism/meshes/triangular_prism.dae</uri>
              <scale>1.0 1.0 0.8</scale>
            </mesh>
          </geometry>
          <material><ambient>0.4 0.6 0.3 1</ambient><diffuse>0.4 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- C3 单个正方体 0.7×0.7 → 1.0×1.0 -->
    <model name='c3_cub'>
      <static>true</static>
      <pose>-1 3 0.5 0 0 0</pose>
      <link name='l'>
        <collision name='c'><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
        <visual name='v'>
          <geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== 东北区域 ===== -->
    <!-- E1 两个圆柱成对 r=0.3→0.42，间距 0.8→1.05 -->
    <model name='e1_cyl_a'>
      <static>true</static>
      <pose>10 2 0.4 0 0 0</pose>
      <link name='l'>
        <collision name='c'><geometry><cylinder><radius>0.42</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name='v'>
          <geometry><cylinder><radius>0.42</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='e1_cyl_b'>
      <static>true</static>
      <pose>10 3.05 0.4 0 0 0</pose>
      <link name='l'>
        <collision name='c'><geometry><cylinder><radius>0.42</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name='v'>
          <geometry><cylinder><radius>0.42</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- E2 单个三棱柱 scale 0.9/0.6 → 1.2/0.9 -->
    <model name='e2_tri'>
      <static>true</static>
      <pose>12 -2 0.4 0 0 -0.7854</pose>
      <link name='l'>
        <collision name='c'>
          <geometry>
            <mesh>
              <uri>model://triangular_prism/meshes/triangular_prism.dae</uri>
              <scale>1.2 0.9 0.8</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='v'>
          <geometry>
            <mesh>
              <uri>model://triangular_prism/meshes/triangular_prism.dae</uri>
              <scale>1.2 0.9 0.8</scale>
            </mesh>
          </geometry>
          <material><ambient>0.4 0.6 0.3 1</ambient><diffuse>0.4 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== 西北区域 ===== -->
    <!-- W1 单个三棱柱 scale 0.7→1.0 -->
    <model name='w1_tri'>
      <static>true</static>
      <pose>-12 2 0.4 0 0 3.1416</pose>
      <link name='l'>
        <collision name='c'>
          <geometry>
            <mesh>
              <uri>model://triangular_prism/meshes/triangular_prism.dae</uri>
              <scale>1.0 1.0 0.8</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='v'>
          <geometry>
            <mesh>
              <uri>model://triangular_prism/meshes/triangular_prism.dae</uri>
              <scale>1.0 1.0 0.8</scale>
            </mesh>
          </geometry>
          <material><ambient>0.4 0.6 0.3 1</ambient><diffuse>0.4 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- W2 两个长方体成对 0.6→0.9，间距 0.7→1.15 -->
    <model name='w2_box_a'>
      <static>true</static>
      <pose>-10 -2 0.35 0 0 0</pose>
      <link name='l'>
        <collision name='c'><geometry><box><size>0.9 0.9 0.7</size></box></geometry></collision>
        <visual name='v'>
          <geometry><box><size>0.9 0.9 0.7</size></box></geometry>
          <material><ambient>0.2 0.6 0.4 1</ambient><diffuse>0.2 0.6 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='w2_box_b'>
      <static>true</static>
      <pose>-10 -3.15 0.35 0 0 0</pose>
      <link name='l'>
        <collision name='c'><geometry><box><size>0.9 0.9 0.7</size></box></geometry></collision>
        <visual name='v'>
          <geometry><box><size>0.9 0.9 0.7</size></box></geometry>
          <material><ambient>0.2 0.6 0.4 1</ambient><diffuse>0.2 0.6 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== 南部大房间 (y < -6.5) ===== -->
    <!-- S1 三件套：box + cyl + box，全部加大并拉开间距 -->
    <model name='s1_box_a'>
      <static>true</static>
      <pose>-4.8 -10 0.3 0 0 0</pose>
      <link name='l'>
        <collision name='c'><geometry><box><size>0.8 0.8 0.6</size></box></geometry></collision>
        <visual name='v'>
          <geometry><box><size>0.8 0.8 0.6</size></box></geometry>
          <material><ambient>0.3 0.5 0.6 1</ambient><diffuse>0.3 0.5 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='s1_cyl'>
      <static>true</static>
      <pose>-3.4 -10 0.45 0 0 0</pose>
      <link name='l'>
        <collision name='c'><geometry><cylinder><radius>0.37</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name='v'>
          <geometry><cylinder><radius>0.37</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='s1_box_b'>
      <static>true</static>
      <pose>-3.4 -11.4 0.35 0 0 0</pose>
      <link name='l'>
        <collision name='c'><geometry><box><size>0.7 0.7 0.7</size></box></geometry></collision>
        <visual name='v'>
          <geometry><box><size>0.7 0.7 0.7</size></box></geometry>
          <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- S2 单个圆柱 r=0.35→0.47 -->
    <model name='s2_cyl'>
      <static>true</static>
      <pose>5 -10 0.4 0 0 0</pose>
      <link name='l'>
        <collision name='c'><geometry><cylinder><radius>0.47</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name='v'>
          <geometry><cylinder><radius>0.47</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.3 0.7 0.3 1</ambient><diffuse>0.3 0.7 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- S3 单个三棱柱 scale 0.8→1.1 -->
    <model name='s3_tri'>
      <static>true</static>
      <pose>-8 -10 0.4 0 0 2.3562</pose>
      <link name='l'>
        <collision name='c'>
          <geometry>
            <mesh>
              <uri>model://triangular_prism/meshes/triangular_prism.dae</uri>
              <scale>1.1 1.1 0.8</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='v'>
          <geometry>
            <mesh>
              <uri>model://triangular_prism/meshes/triangular_prism.dae</uri>
              <scale>1.1 1.1 0.8</scale>
            </mesh>
          </geometry>
          <material><ambient>0.4 0.6 0.3 1</ambient><diffuse>0.4 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== 东南区域 (x>7.5, y<-2) ===== -->
    <!-- SE1 单个圆柱 r=0.4→0.52 -->
    <model name='se1_cyl'>
      <static>true</static>
      <pose>10 -10 0.35 0 0 0</pose>
      <link name='l'>
        <collision name='c'><geometry><cylinder><radius>0.52</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name='v'>
          <geometry><cylinder><radius>0.52</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- SE2 两个长方体成对 0.6/0.4→0.9/0.7，间距 0.7→1.15 -->
    <model name='se2_box_a'>
      <static>true</static>
      <pose>12 -10 0.4 0 0 0</pose>
      <link name='l'>
        <collision name='c'><geometry><box><size>0.9 0.9 0.8</size></box></geometry></collision>
        <visual name='v'>
          <geometry><box><size>0.9 0.9 0.8</size></box></geometry>
          <material><ambient>0.2 0.6 0.4 1</ambient><diffuse>0.2 0.6 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='se2_box_b'>
      <static>true</static>
      <pose>12 -11.25 0.3 0 0 0</pose>
      <link name='l'>
        <collision name='c'><geometry><box><size>0.7 0.9 0.6</size></box></geometry></collision>
        <visual name='v'>
          <geometry><box><size>0.7 0.9 0.6</size></box></geometry>
          <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
