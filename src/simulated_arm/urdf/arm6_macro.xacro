<?xml version="1.0"?>
<!--
  六轴垂直多关节机械臂宏（研究阶段基础模型）

  构型: J1 基座回转(z) + J2 肩俯仰(y) + J3 肘俯仰(y) + J4 前臂回转(z)
        + J5 腕俯仰(y) + J6 法兰回转(z)，零位时整臂竖直，全展开高度约 1.02m

  用法1（独立仿真，arm6_standalone.urdf.xacro 已封装）:
    <xacro:arm6_macro parent_link="world" mount_xyz="0 0 0" mount_rpy="0 0 0"
                     use_ignition="true"/>
  用法2（装配到三舵轮底盘，在底盘 xacro 中）:
    <xacro:arm6_macro parent_link="base_link" mount_xyz="0.15 0 0.12"
                     mount_rpy="0 0 0" use_ignition="true"/>

  参数:
    parent_link      挂载的父 link（固定连接）
    use_ignition     true=Ignition Gazebo 硬件(ign_ros2_control)，
                     false=mock 硬件(fake_components，RViz 纯规划用)
    controllers_yaml ign 插件加载的 ros2_control 控制器参数文件
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="arm6_macro"
    params="parent_link mount_xyz:='0 0 0' mount_rpy:='0 0 0'
            use_ignition:=false
            controllers_yaml:='$(find simulated_arm)/config/ros2_controllers_sim.yaml'">

    <!-- 统一转成布尔，供 xacro:if 使用
         （新版 xacro 会把宏参数 "false" 自动解析成 bool，str() 兼容两种类型） -->
    <xacro:property name="use_ign"
                    value="${str(use_ignition).lower() in ('true', '1', 'yes')}"/>

    <!-- 首选初始位姿（RViz mock 与 Gazebo 均以此为初始关节角，避免竖直零位奇异） -->
    <xacro:property name="home_j1" value="0.0"/>
    <xacro:property name="home_j2" value="-0.45"/>
    <xacro:property name="home_j3" value="0.9"/>
    <xacro:property name="home_j4" value="0.0"/>
    <xacro:property name="home_j5" value="-0.45"/>
    <xacro:property name="home_j6" value="0.0"/>

    <!-- ===================== 底座（安装法兰盘） ===================== -->
    <link name="arm_base_link">
      <visual>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <geometry>
          <box size="0.16 0.16 0.02"/>
        </geometry>
        <material name="arm_grey"><color rgba="0.35 0.35 0.35 1.0"/></material>
      </visual>
      <visual>
        <origin xyz="0 0 0.07" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.07" length="0.10"/>
        </geometry>
        <material name="arm_white"><color rgba="0.92 0.92 0.92 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <geometry>
          <box size="0.16 0.16 0.02"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0.07" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.07" length="0.10"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <mass value="3.0"/>
        <inertia ixx="0.0062" ixy="0" ixz="0" iyy="0.0062" iyz="0" izz="0.0074"/>
      </inertial>
    </link>

    <joint name="arm_mount_joint" type="fixed">
      <origin xyz="${mount_xyz}" rpy="${mount_rpy}"/>
      <parent link="${parent_link}"/>
      <child link="arm_base_link"/>
    </joint>

    <!-- ===================== J1 基座回转 ===================== -->
    <link name="arm_link1">
      <visual>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.062" length="0.12"/>
        </geometry>
        <material name="arm_orange"><color rgba="0.96 0.42 0.05 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.062" length="0.12"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <mass value="1.8"/>
        <inertia ixx="0.0039" ixy="0" ixz="0" iyy="0.0039" iyz="0" izz="0.0035"/>
      </inertial>
    </link>

    <joint name="arm_joint1" type="revolute">
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <parent link="arm_base_link"/>
      <child link="arm_link1"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.79" upper="2.79" effort="60" velocity="2.0"/>
      <dynamics damping="0.5" friction="0.0"/>
    </joint>

    <!-- ===================== J2 肩关节（大臂） ===================== -->
    <link name="arm_link2">
      <visual>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="0.30"/>
        </geometry>
        <material name="arm_white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="0.30"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
        <mass value="1.2"/>
        <inertia ixx="0.0098" ixy="0" ixz="0" iyy="0.0098" iyz="0" izz="0.0015"/>
      </inertial>
    </link>

    <joint name="arm_joint2" type="revolute">
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <parent link="arm_link1"/>
      <child link="arm_link2"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.35" upper="2.35" effort="88" velocity="2.0"/>
      <dynamics damping="0.5" friction="0.0"/>
    </joint>

    <!-- ===================== J3 肘关节（小臂） ===================== -->
    <link name="arm_link3">
      <visual>
        <origin xyz="0 0 0.12" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.04" length="0.24"/>
        </geometry>
        <material name="arm_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.12" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.04" length="0.24"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.12" rpy="0 0 0"/>
        <mass value="0.8"/>
        <inertia ixx="0.0042" ixy="0" ixz="0" iyy="0.0042" iyz="0" izz="0.00064"/>
      </inertial>
    </link>

    <joint name="arm_joint3" type="revolute">
      <origin xyz="0 0 0.30" rpy="0 0 0"/>
      <parent link="arm_link2"/>
      <child link="arm_link3"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.62" upper="2.62" effort="44" velocity="2.5"/>
      <dynamics damping="0.5" friction="0.0"/>
    </joint>

    <!-- ===================== J4 前臂回转 ===================== -->
    <link name="arm_link4">
      <visual>
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.09"/>
        </geometry>
        <material name="arm_white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.09"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.00049" ixy="0" ixz="0" iyy="0.00049" iyz="0" izz="0.00031"/>
      </inertial>
    </link>

    <joint name="arm_joint4" type="revolute">
      <origin xyz="0 0 0.24" rpy="0 0 0"/>
      <parent link="arm_link3"/>
      <child link="arm_link4"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.07" upper="3.07" effort="21" velocity="3.0"/>
      <dynamics damping="0.2" friction="0.0"/>
    </joint>

    <!-- ===================== J5 腕俯仰 ===================== -->
    <link name="arm_link5">
      <visual>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.032" length="0.08"/>
        </geometry>
        <material name="arm_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.032" length="0.08"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <mass value="0.35"/>
        <inertia ixx="0.00028" ixy="0" ixz="0" iyy="0.00028" iyz="0" izz="0.00018"/>
      </inertial>
    </link>

    <joint name="arm_joint5" type="revolute">
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <parent link="arm_link4"/>
      <child link="arm_link5"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.44" upper="2.44" effort="21" velocity="3.0"/>
      <dynamics damping="0.2" friction="0.0"/>
    </joint>

    <!-- ===================== J6 法兰回转 + 工具坐标系 ===================== -->
    <link name="arm_link6">
      <visual>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.03" length="0.05"/>
        </geometry>
        <material name="arm_white"/>
      </visual>
      <visual>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.024" length="0.02"/>
        </geometry>
        <material name="arm_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.03" length="0.05"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <mass value="0.25"/>
        <inertia ixx="0.00011" ixy="0" ixz="0" iyy="0.00011" iyz="0" izz="0.00011"/>
      </inertial>
    </link>

    <joint name="arm_joint6" type="revolute">
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <parent link="arm_link5"/>
      <child link="arm_link6"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.22" upper="3.22" effort="15" velocity="3.5"/>
      <dynamics damping="0.2" friction="0.0"/>
    </joint>

    <!-- 工具坐标系：纯 frame，MoveIt 规划组 tip -->
    <link name="arm_tool0"/>
    <joint name="arm_tool_joint" type="fixed">
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <parent link="arm_link6"/>
      <child link="arm_tool0"/>
    </joint>

    <!-- ===================== ros2_control ===================== -->
    <ros2_control name="ArmSystem" type="system">
      <xacro:if value="${use_ign}">
        <hardware>
          <plugin>ign_ros2_control/IgnitionSystem</plugin>
        </hardware>
      </xacro:if>
      <xacro:unless value="${use_ign}">
        <hardware>
          <plugin>fake_components/GenericSystem</plugin>
        </hardware>
      </xacro:unless>

      <joint name="arm_joint1">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${home_j1}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="arm_joint2">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${home_j2}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="arm_joint3">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${home_j3}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="arm_joint4">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${home_j4}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="arm_joint5">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${home_j5}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="arm_joint6">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${home_j6}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>

    <!-- ===================== Gazebo（Ignition Fortress） ===================== -->
    <xacro:if value="${use_ign}">
      <gazebo>
        <plugin filename="ign_ros2_control-system"
                name="ign_ros2_control::IgnitionROS2ControlPlugin">
          <robot_param>robot_description</robot_param>
          <robot_param_node>robot_state_publisher</robot_param_node>
          <parameters>${controllers_yaml}</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

    <gazebo reference="arm_base_link">
      <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
    </gazebo>
    <gazebo reference="arm_link1">
      <material><ambient>0.96 0.42 0.05 1</ambient><diffuse>0.96 0.42 0.05 1</diffuse></material>
    </gazebo>
    <gazebo reference="arm_link2">
      <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
    </gazebo>
    <gazebo reference="arm_link3">
      <material><ambient>0.96 0.42 0.05 1</ambient><diffuse>0.96 0.42 0.05 1</diffuse></material>
    </gazebo>
    <gazebo reference="arm_link4">
      <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
    </gazebo>
    <gazebo reference="arm_link5">
      <material><ambient>0.96 0.42 0.05 1</ambient><diffuse>0.96 0.42 0.05 1</diffuse></material>
    </gazebo>
    <gazebo reference="arm_link6">
      <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
    </gazebo>

  </xacro:macro>
</robot>
