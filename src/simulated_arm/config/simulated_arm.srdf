<?xml version="1.0" encoding="UTF-8"?>
<!-- 六轴臂语义描述：规划组、预定义位姿、碰撞对裁剪 -->
<robot name="simulated_arm">
  <group name="arm">
    <chain base_link="arm_base_link" tip_link="arm_tool0"/>
  </group>

  <!-- 常用位姿（与 xacro initial_value 一致） -->
  <group_state name="home" group="arm">
    <joint name="arm_joint1" value="0.0"/>
    <joint name="arm_joint2" value="-0.45"/>
    <joint name="arm_joint3" value="0.9"/>
    <joint name="arm_joint4" value="0.0"/>
    <joint name="arm_joint5" value="-0.45"/>
    <joint name="arm_joint6" value="0.0"/>
  </group_state>

  <group_state name="extended" group="arm">
    <joint name="arm_joint1" value="0.0"/>
    <joint name="arm_joint2" value="0.0"/>
    <joint name="arm_joint3" value="0.0"/>
    <joint name="arm_joint4" value="0.0"/>
    <joint name="arm_joint5" value="0.0"/>
    <joint name="arm_joint6" value="0.0"/>
  </group_state>

  <group_state name="folded" group="arm">
    <joint name="arm_joint1" value="0.0"/>
    <joint name="arm_joint2" value="-1.2"/>
    <joint name="arm_joint3" value="2.0"/>
    <joint name="arm_joint4" value="0.0"/>
    <joint name="arm_joint5" value="-0.8"/>
    <joint name="arm_joint6" value="0.0"/>
  </group_state>

  <!-- 相邻连杆 + 折叠时必然贴近的连杆对 -->
  <disable_collisions link1="arm_base_link" link2="arm_link1" reason="Adjacent"/>
  <disable_collisions link1="arm_base_link" link2="arm_link2" reason="Never"/>
  <disable_collisions link1="arm_link1" link2="arm_link2" reason="Adjacent"/>
  <disable_collisions link1="arm_link1" link2="arm_link3" reason="Never"/>
  <disable_collisions link1="arm_link2" link2="arm_link3" reason="Adjacent"/>
  <disable_collisions link1="arm_link2" link2="arm_link4" reason="Never"/>
  <disable_collisions link1="arm_link3" link2="arm_link4" reason="Adjacent"/>
  <disable_collisions link1="arm_link3" link2="arm_link5" reason="Never"/>
  <disable_collisions link1="arm_link4" link2="arm_link5" reason="Adjacent"/>
  <disable_collisions link1="arm_link5" link2="arm_link6" reason="Adjacent"/>
</robot>
