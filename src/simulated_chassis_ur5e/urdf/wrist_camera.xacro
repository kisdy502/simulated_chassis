<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="wrist_camera" params="camera_file">
    <xacro:property name="cam" value="${xacro.load_yaml(camera_file)}"/>
    <xacro:if value="${cam['enabled']}">
      <!-- Housing: X forward, Y left, Z up. Front lens at X=0.025. -->
      <link name="ur5e_camera_link">
        <inertial>
          <!-- Housing 100 g + rear support rod 30 g, combined inertia. -->
          <origin xyz="-0.0103846154 0 0"/>
          <mass value="0.13"/>
          <inertia ixx="0.0000315" iyy="0.0000814808" izz="0.0000931474" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual name="camera_housing"><geometry><box size="0.05 0.05 0.035"/></geometry><material name="camera_orange"><color rgba="1 0.35 0.02 1"/></material></visual>
        <collision><geometry><box size="0.05 0.05 0.035"/></geometry></collision>
        <!-- Solid 20 mm diameter, 40 mm long rear rod. With the default mount
             it spans tool0 Z=0..0.04 and meets the housing rear face exactly.
             Both geometries form one rigid link; no extra actuated joint. -->
        <visual name="camera_support">
          <origin xyz="-0.045 0 0" rpy="0 ${pi/2} 0"/>
          <geometry><cylinder radius="0.01" length="0.04"/></geometry>
          <material name="camera_support_green"><color rgba="0.1 0.75 0.15 1"/></material>
        </visual>
        <collision name="camera_support_collision">
          <origin xyz="-0.045 0 0" rpy="0 ${pi/2} 0"/>
          <geometry><cylinder radius="0.01" length="0.04"/></geometry>
        </collision>
      </link>
      <joint name="ur5e_camera_joint" type="fixed">
        <parent link="ur5e_tool0"/><child link="ur5e_camera_link"/>
        <origin xyz="${cam['xyz']}" rpy="${cam['rpy']}"/>
      </joint>
      <link name="ur5e_camera_optical_frame"/>
      <joint name="ur5e_camera_optical_joint" type="fixed">
        <parent link="ur5e_camera_link"/><child link="ur5e_camera_optical_frame"/>
        <origin xyz="0.025 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
      </joint>
      <!-- Existing chassis Sensors system renders this sensor too. -->
      <gazebo reference="ur5e_camera_link">
        <sensor name="wrist_rgb" type="camera">
          <pose>0.025 0 0 0 0 0</pose>
          <always_on>true</always_on><visualize>false</visualize>
          <update_rate>${cam['update_rate']}</update_rate>
          <topic>/wrist_camera/image</topic>
          <camera>
            <horizontal_fov>${cam['horizontal_fov']}</horizontal_fov>
            <image><width>${cam['width']}</width><height>${cam['height']}</height><format>R8G8B8</format></image>
            <clip><near>${cam['near']}</near><far>${cam['far']}</far></clip>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
