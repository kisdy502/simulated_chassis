<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:macro name="mounted_ur5e" params="mounting_file">
    <xacro:property name="mount" value="${xacro.load_yaml(mounting_file)}"/>
    <xacro:property name="h" value="${mount['pedestal_height']}"/>
    <xacro:property name="r" value="${mount['pedestal_radius']}"/>
    <xacro:property name="m" value="${mount['pedestal_mass']}"/>
    <link name="arm_mount_link">
      <inertial>
        <origin xyz="0 0 ${h/2}"/>
        <mass value="${m}"/>
        <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}"/>
      </inertial>
      <visual><origin xyz="0 0 ${h/2}"/><geometry><cylinder radius="${r}" length="${h}"/></geometry><material name="grey"/></visual>
      <collision><origin xyz="0 0 ${h/2}"/><geometry><cylinder radius="${r}" length="${h}"/></geometry></collision>
    </link>
    <joint name="arm_mount_joint" type="fixed">
      <parent link="base_link"/><child link="arm_mount_link"/>
      <origin xyz="${mount['xyz']}" rpy="${mount['rpy']}"/>
    </joint>
    <xacro:ur_robot name="UR5eSystem" tf_prefix="ur5e_" parent="arm_mount_link" ur_type="ur5e"
      joint_limits_parameters_file="$(find ur_description)/config/ur5e/joint_limits.yaml"
      kinematics_parameters_file="$(find ur_description)/config/ur5e/default_kinematics.yaml"
      physical_parameters_file="$(find ur_description)/config/ur5e/physical_parameters.yaml"
      visual_parameters_file="$(find ur_description)/config/ur5e/visual_parameters.yaml"
      sim_ignition="true" safety_limits="true"
      initial_positions="${xacro.load_yaml('$(find simulated_ur5e)/config/initial_positions.yaml')}">
      <origin xyz="0 0 ${h}" rpy="0 0 0"/>
    </xacro:ur_robot>
  </xacro:macro>
</robot>
