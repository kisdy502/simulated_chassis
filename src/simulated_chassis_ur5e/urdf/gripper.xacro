<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="parallel_gripper" params="gripper_file">
    <xacro:property name="grip" value="${xacro.load_yaml(gripper_file)}"/>
    <link name="ur5e_gripper_base">
      <inertial><origin xyz="0 0 0.025"/><mass value="0.25"/>
        <inertia ixx="0.0001623" iyy="0.0001623" izz="0.0002205" ixy="0" ixz="0" iyz="0"/></inertial>
      <visual><origin xyz="0 0 0.025"/><geometry><cylinder radius="0.042" length="0.05"/></geometry>
        <material name="gripper_blue"><color rgba="0.12 0.35 0.65 1"/></material></visual>
      <collision><origin xyz="0 0 0.025"/><geometry><cylinder radius="0.042" length="0.05"/></geometry></collision>
    </link>
    <joint name="ur5e_gripper_mount" type="fixed">
      <parent link="ur5e_tool0"/><child link="ur5e_gripper_base"/>
      <origin xyz="${grip['xyz']}" rpy="${grip['rpy']}"/>
    </joint>
    <xacro:macro name="parallel_finger" params="side sign">
      <link name="ur5e_gripper_${side}_finger">
        <inertial><origin xyz="0 0 0.04"/><mass value="0.04"/>
          <inertia ixx="0.0000218133" iyy="0.0000224133" izz="0.00000156" ixy="0" ixz="0" iyz="0"/></inertial>
        <visual><origin xyz="0 0 0.04"/><geometry><box size="0.018 0.012 0.08"/></geometry>
          <material name="gripper_silver"><color rgba="0.75 0.78 0.8 1"/></material></visual>
        <collision><origin xyz="0 0 0.04"/><geometry><box size="0.018 0.012 0.08"/></geometry></collision>
      </link>
      <joint name="ur5e_gripper_${side}_joint" type="prismatic">
        <parent link="ur5e_gripper_base"/><child link="ur5e_gripper_${side}_finger"/>
        <origin xyz="0 ${sign*0.006} 0.05"/><axis xyz="0 ${sign} 0"/>
        <limit lower="0" upper="${grip['max_width']/2}" effort="20" velocity="${grip['finger_speed']}"/>
        <dynamics damping="2.0" friction="0.1"/>
      </joint>
      <gazebo reference="ur5e_gripper_${side}_finger"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
    </xacro:macro>
    <xacro:parallel_finger side="left" sign="${1}"/>
    <xacro:parallel_finger side="right" sign="${-1}"/>
    <link name="ur5e_gripper_tcp"/>
    <joint name="ur5e_gripper_tcp_joint" type="fixed">
      <parent link="ur5e_gripper_base"/><child link="ur5e_gripper_tcp"/><origin xyz="0 0 0.11"/>
    </joint>
    <!-- Independent joints avoid Gazebo Fortress mimic-joint support differences. -->
    <ros2_control name="GenericGripperSystem" type="system">
      <hardware><plugin>ign_ros2_control/IgnitionSystem</plugin></hardware>
      <xacro:macro name="gripper_interface" params="side">
        <joint name="ur5e_gripper_${side}_joint">
          <command_interface name="position"><param name="min">0</param><param name="max">${grip['max_width']/2}</param></command_interface>
          <state_interface name="position"><param name="initial_value">${grip['initial_width']/2}</param></state_interface>
          <state_interface name="velocity"/>
        </joint>
      </xacro:macro>
      <xacro:gripper_interface side="left"/><xacro:gripper_interface side="right"/>
    </ros2_control>
  </xacro:macro>
</robot>
