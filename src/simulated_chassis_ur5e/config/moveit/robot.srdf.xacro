<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="three_wheel_agv">
  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>
  <xacro:ur_srdf name="ur" prefix="ur5e_"/>
  <xacro:arg name="tool_type" default="gripper"/>
  <xacro:arg name="gripper_file" default="$(find simulated_chassis_ur5e)/config/gripper.yaml"/>
  <xacro:if value="${'$(arg tool_type)' == 'gripper'}">
    <xacro:property name="grip" value="${xacro.load_yaml('$(arg gripper_file)')}"/>
    <group name="ur5e_gripper"><joint name="ur5e_gripper_left_joint"/><joint name="ur5e_gripper_right_joint"/></group>
    <group_state name="open" group="ur5e_gripper">
      <joint name="ur5e_gripper_left_joint" value="${grip['max_width']/2}"/><joint name="ur5e_gripper_right_joint" value="${grip['max_width']/2}"/>
    </group_state>
    <group_state name="closed" group="ur5e_gripper">
      <joint name="ur5e_gripper_left_joint" value="0"/><joint name="ur5e_gripper_right_joint" value="0"/>
    </group_state>
    <end_effector name="parallel_gripper" parent_link="ur5e_gripper_tcp" group="ur5e_gripper" parent_group="ur5e_ur_manipulator"/>
    <disable_collisions link1="ur5e_wrist_3_link" link2="ur5e_gripper_base" reason="Adjacent"/>
    <disable_collisions link1="ur5e_gripper_base" link2="ur5e_gripper_left_finger" reason="Adjacent"/>
    <disable_collisions link1="ur5e_gripper_base" link2="ur5e_gripper_right_finger" reason="Adjacent"/>
    <disable_collisions link1="ur5e_gripper_left_finger" link2="ur5e_gripper_right_finger" reason="Touching"/>
  </xacro:if>
  <xacro:property name="initial" value="${xacro.load_yaml('$(find simulated_ur5e)/config/initial_positions.yaml')}"/>
  <group_state name="stowed" group="ur5e_ur_manipulator">
    <joint name="ur5e_shoulder_pan_joint" value="${initial['shoulder_pan_joint']}"/>
    <joint name="ur5e_shoulder_lift_joint" value="${initial['shoulder_lift_joint']}"/>
    <joint name="ur5e_elbow_joint" value="${initial['elbow_joint']}"/>
    <joint name="ur5e_wrist_1_joint" value="${initial['wrist_1_joint']}"/>
    <joint name="ur5e_wrist_2_joint" value="${initial['wrist_2_joint']}"/>
    <joint name="ur5e_wrist_3_joint" value="${initial['wrist_3_joint']}"/>
  </group_state>
  <!-- Base joints are sensed but never planned/executed by MoveIt. -->
  <passive_joint name="wheel_front_steering_joint"/><passive_joint name="wheel_left_steering_joint"/><passive_joint name="wheel_right_steering_joint"/>
  <passive_joint name="wheel_front_wheel_joint"/><passive_joint name="wheel_left_wheel_joint"/><passive_joint name="wheel_right_wheel_joint"/>
  <disable_collisions link1="base_link" link2="arm_mount_link" reason="Adjacent"/>
  <disable_collisions link1="arm_mount_link" link2="ur5e_base_link_inertia" reason="Adjacent"/>
  <!-- Fixed/adjacent chassis geometry intentionally touches; arm vs chassis is NOT disabled. -->
  <disable_collisions link1="base_link" link2="front_lidar_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="rear_lidar_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_front_steering_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_left_steering_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_right_steering_link" reason="Adjacent"/>
  <disable_collisions link1="wheel_front_steering_link" link2="wheel_front_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="wheel_left_steering_link" link2="wheel_left_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="wheel_right_steering_link" link2="wheel_right_wheel_link" reason="Adjacent"/>
</robot>
