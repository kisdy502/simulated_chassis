<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agv_bridge_v2</name>
  <version>0.2.0</version>
  <description>
    AGV 与仿真机器人之间的对接层（rosbridge 架构）。
    瘦节点 agv_nav_server 只做路径生成与 nav2 调度，对外暴露标准 ROS 2 接口，
    由 rosbridge_server 以上位机可直连的 JSON over WebSocket 协议对外提供服务。
  </description>
  <maintainer email="robot@todo.todo">robot</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>cartographer_ros_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>angles</depend>

  <!-- 标准接口包：/agv/follow_edge、/agv/set_control、/agv/status -->
  <depend>agv_bridge_v2_interfaces</depend>

  <exec_depend>ros2launch</exec_depend>
  <!-- 对外 WebSocket(JSON) 通信由 rosbridge_server 承担 -->
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>rosapi</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
