<?xml version="1.0"?>
<package format="3">
  <name>arm_manager</name><version>0.1.0</version>
  <description>Arm task manager with MoveIt planning/execution and persistent teaching.</description>
  <maintainer email="user@example.com">jzt_robot</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>arm_manager_interfaces</exec_depend>
  <exec_depend>moveit_msgs</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend><exec_depend>std_srvs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
