<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simulated_dual_arm</name>
  <version>0.1.0</version>
  <description>线束质检机器人上装仿真:双 7 轴臂 + 2 轴腰(视觉级),与底盘组合;含 /joint_states 合并、/agv/arm_move 与 URDF mesh 静态服务</description>
  <maintainer email="weiping.bi@zioneer.com">kisdy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>agv_bridge_v2_interfaces</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>simulated_chassis</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
